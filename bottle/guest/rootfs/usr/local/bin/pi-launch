#!/bin/sh
# Starts Pi from the trusted configuration the host mounted read-only at /etc/bottle.
set -eu
mkdir -p "$HOME/.pi/agent" /work/.pi-session
cp /etc/bottle/models.json /etc/bottle/settings.json /etc/bottle/APPEND_SYSTEM.md /etc/bottle/mcp.json /etc/bottle/proper-base.json "$HOME/.pi/agent/"
# Config files of the loaded extensions (catalog `files`), already named for ~/.pi/agent
cp -r /etc/bottle/agent-files/. "$HOME/.pi/agent/"
cd /work
set --
# Always-on extensions baked into the image (pinned in guest/pi-package.json); opt-in ones arrive as -e args.
# They load first: Pi runs session_start handlers in load order, and the launch prompt that request-capability.ts sends
# there must not reach before_agent_start before proper-base has armed its session title.
for extension in /opt/pi-extensions/*; do set -- "$@" -e "$extension"; done
while IFS= read -r argument; do set -- "$@" "$argument"; done < /etc/bottle/args
exec pi "$@" 2>/run/pi.err
