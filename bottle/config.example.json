{
  "bindHost": "100.64.0.10",
  "controlPort": 7001,
  "guestPort": 7002,
  "maxAgents": 3,
  "guestImage": "bottle-guest",
  "speaker": {
    "url": "http://100.64.0.10:7000",
    "proxyPort": 7003,
    "sshPort": 7004
  },
  "stateRoot": "/srv/bottle/state",
  "outputRoot": "/srv/bottle/output",
  "localModel": {
    "guestHost": "model.internal",
    "upstream": "127.0.0.1:8080",
    "models": [
      {
        "id": "qwen3-coder-30b",
        "label": "Qwen3 Coder 30B",
        "alias": "qwen",
        "contextWindow": 262144
      }
    ]
  },
  "hostedProviders": [
    {
      "id": "openrouter",
      "service": "openrouter",
      "models": [
        {
          "id": "moonshotai/kimi-k2",
          "label": "Kimi K2",
          "alias": "kimi"
        },
        {
          "id": "google/gemini-2.5-pro",
          "label": "Gemini 2.5 Pro"
        },
        {
          "id": "deepseek/deepseek-v4.1-flash-1017",
          "label": "DeepSeek V4.1 Flash",
          "alias": "deepseek",
          "openRouterRouting": {
            "only": ["deepinfra/fp8"],
            "allow_fallbacks": false
          }
        }
      ]
    },
    {
      "id": "anthropic",
      "service": "anthropic",
      "api": "anthropic-messages",
      "models": [
        {
          "id": "claude-sonnet-5-5",
          "label": "Claude Sonnet 5.5",
          "alias": "sonnet"
        },
        {
          "id": "claude-haiku-5-5",
          "label": "Claude Haiku 5.5",
          "alias": "haiku"
        }
      ]
    },
    {
      "id": "openai",
      "service": "openai",
      "models": [
        {
          "id": "gpt-5",
          "label": "GPT-5",
          "alias": "gpt5"
        },
        {
          "id": "gpt-5-mini",
          "label": "GPT-5 mini"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "sealed",
      "label": "Sealed: the agent space, no network",
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "rootfsGiB": 8,
        "workGiB": 20,
        "maxRuntimeHours": 24
      },
      "want": ["ext:pi-cc-monitor", "ext:pi-cc-loop"],
      "duration": "1d",
      "folders": ["~/agent-space:rw"]
    },
    {
      "id": "builder",
      "label": "Builder: agent space, packages, public GitHub, docs and web search",
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "rootfsGiB": 8,
        "workGiB": 20,
        "maxRuntimeHours": 72,
        "maxModelRequests": 1500
      },
      "want": ["ext:pi-cc-monitor", "ext:pi-cc-loop", "group:developer", "group:research"],
      "duration": "1d",
      "folders": ["~/agent-space:rw"]
    },
    {
      "id": "trusted",
      "label": "Trusted: builder plus Parallel web search and fetch of any page",
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "rootfsGiB": 8,
        "workGiB": 20,
        "maxRuntimeHours": 24
      },
      "want": ["ext:pi-cc-monitor", "ext:pi-cc-loop", "group:developer", "group:research", "parallel-search.read"],
      "duration": "1d",
      "folders": ["~/agent-space:rw"]
    },
    {
      "id": "cron",
      "label": "Cron: wakes itself on a schedule for up to a week, with web search",
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "rootfsGiB": 8,
        "workGiB": 20,
        "maxRuntimeHours": 168,
        "maxModelRequests": 3000
      },
      "want": ["ext:pi-cc-monitor", "ext:pi-cc-loop", "group:research"],
      "duration": "30d",
      "folders": ["~/agent-space:rw"]
    }
  ]
}
