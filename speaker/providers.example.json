  "karakeep": {
    "baseUrl": "https://bookmarks.example.com/api/v1",
    "guide": "# Karakeep\n\nBookmarks API under `/karakeep/`.\n\n- `GET /karakeep/bookmarks` lists bookmarks.\n- `GET /karakeep/bookmarks/search?q=<text>` searches them.\n- `POST /karakeep/bookmarks` with `{\"type\":\"link\",\"url\":\"...\"}` adds one.\n\nReads need `karakeep.read`. Other methods need `karakeep.write`.\n",
    "auth": {
      "type": "bearer",
      "secret": "karakeep"
    },
    "policy": {
      "read": "approval",
      "write": "approval"
    }
  },
