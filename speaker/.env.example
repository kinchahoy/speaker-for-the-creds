DATA_DIR=./data
PORT=3000
# Set this to the exact browser-facing URL when using a reverse proxy.
PUBLIC_URL=http://localhost:3000

# Optional phone notifications: use the ntfy server root URL and a private topic.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=your-private-topic
# NTFY_TOKEN=your-publish-token

# Optional SSH and folders over SSH: the jump server's port (it listens only while an SSH or folder grant is active).
# SSH_PORT=2222

# Optional secrets proxy: the port agents send HTTPS CONNECT to, so speaker can insert their `secret:` tokens.
# PROXY_PORT=3128

# Optional: IP of the reverse proxy in front of speaker; only it may name the caller via X-Forwarded-For.
# TRUSTED_PROXY=172.18.0.2
