DATA_DIR=./data
PORT=3000
# The exact URL you open in the browser. Behind a reverse proxy, use the proxy's URL.
PUBLIC_URL=http://localhost:3000

# Required. SSH and folders over SSH: the jump server's port. It listens only while an SSH or folder grant is active.
SSH_PORT=2222

# Required. Secrets proxy: the port agents send HTTPS CONNECT requests to, so speaker can insert their `secret:` values.
PROXY_PORT=3128

# Optional: the reverse proxy's IP. Only it may name the caller through X-Forwarded-For.
# TRUSTED_PROXY=172.18.0.2 (or a name, such as the proxy's Docker service: TRUSTED_PROXY=traefik)
