DATA_DIR=./data
PORT=3000
# The exact URL you open in the browser. Behind a reverse proxy, use the proxy's URL.
PUBLIC_URL=http://localhost:3000

# Optional phone notifications. NTFY_URL is the ntfy server root; NTFY_TOPIC is a private topic.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=your-private-topic
# NTFY_TOKEN=your-publish-token

# Optional SSH and folders over SSH: the jump server's port. It listens only while an SSH or folder grant is active.
# SSH_PORT=2222

# Optional secrets proxy: the port agents send HTTPS CONNECT requests to, so speaker can insert their `secret:` values.
# PROXY_PORT=3128

# Optional: the reverse proxy's IP. Only it may name the caller through X-Forwarded-For.
# TRUSTED_PROXY=172.18.0.2
