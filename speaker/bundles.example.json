{
  "packages": {
    "description": "Install Python and npm packages from PyPI and the npm registry.",
    "members": [
      { "kind": "site", "ref": "pypi.org" },
      { "kind": "site", "ref": "files.pythonhosted.org" },
      { "kind": "site", "ref": "registry.npmjs.org" }
    ]
  },
  "github-read": {
    "description": "Clone and read GitHub repositories, with a read-only GitHub API token.",
    "members": [
      { "kind": "site", "ref": "github.com" },
      { "kind": "site", "ref": "codeload.github.com" },
      { "kind": "site", "ref": "raw.githubusercontent.com" },
      { "kind": "secret", "ref": "GITHUB_READ@api.github.com" }
    ]
  },
  "developer": {
    "description": "Everyday coding: package registries, GitHub downloads and releases, and Context7 library docs.",
    "members": [
      { "kind": "site", "ref": "pypi.org" },
      { "kind": "site", "ref": "files.pythonhosted.org" },
      { "kind": "site", "ref": "registry.npmjs.org" },
      { "kind": "site", "ref": "github.com" },
      { "kind": "site", "ref": "codeload.github.com" },
      { "kind": "site", "ref": "raw.githubusercontent.com" },
      { "kind": "site", "ref": "release-assets.githubusercontent.com" },
      { "kind": "site", "ref": "objects.githubusercontent.com" },
      { "kind": "mcp", "ref": "context7" }
    ]
  },
  "research": {
    "description": "Public web research: keyless Exa search through the pi-web-access extension, plus Wikipedia and arXiv pages.",
    "members": [
      { "kind": "extension", "ref": "pi-web-access" },
      { "kind": "site", "ref": "mcp.exa.ai" },
      { "kind": "site", "ref": "*.wikipedia.org" },
      { "kind": "site", "ref": "arxiv.org" },
      { "kind": "site", "ref": "export.arxiv.org" }
    ]
  },
  "loop": {
    "description": "Scheduled and self-paced wake-ups (/loop, cron jobs) and background process monitors, with no network access.",
    "members": [{ "kind": "extension", "ref": "pi-cc-loop" }, { "kind": "extension", "ref": "pi-cc-monitor" }]
  },
  "notes-read": {
    "description": "Read the owner's Obsidian notes and Karakeep bookmarks through speaker's proxy.",
    "members": [{ "kind": "credential", "ref": "obsidian.read" }, { "kind": "credential", "ref": "karakeep.read" }]
  }
}
