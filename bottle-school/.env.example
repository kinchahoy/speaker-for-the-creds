# Copy to bottle-school/.env (gitignored). mise loads it for every task.
# `mise run setup` turns these into bottle-school/config.json (also gitignored); edit config.json afterward.

# Local inference endpoint: loopback, RFC1918, or Tailscale IPv4 host:port (no scheme, no hostnames).
LLM_UPSTREAM=192.168.1.20:8080
# One model id from GET http://$LLM_UPSTREAM/v1/models.
LLM_MODEL=my-model

# Speaker base URL (origin only, without /admin).
SPEAKER_URL=https://speaker.example.net
# Speaker's PROXY_PORT: where requests to a granted secret's hosts go so speaker can insert the secret. Needed for secret: items.
# SPEAKER_PROXY_PORT=3128
# Speaker's SSH_PORT: how the microsandbox backend's guest reaches speaker's jump server. Needed for folder: items there.
# SPEAKER_SSH_PORT=2222

# Where config, state and output live. Default: ~/.local/share/bottle-school
# BOTTLE_HOME=

# Gondolin backend only ("backend": "gondolin" in config.json; microsandbox, the default, ignores this): krun (default; on x86_64
# run `mise run krun-runner` once) or qemu. See README "VM backends".
# PI_V2_VMM=krun
