# Copy to bottle-school/.env (gitignored). mise loads it for every task.
# `mise run setup` turns these into bottle-school/config.json (also gitignored); edit config.json afterward.

# Local inference endpoint: loopback, RFC1918, or Tailscale IPv4 host:port (no scheme, no hostnames).
LLM_UPSTREAM=192.168.1.20:8080
# One model id from GET http://$LLM_UPSTREAM/v1/models.
LLM_MODEL=my-model

# Speaker base URL (origin only, without /admin).
SPEAKER_URL=https://speaker.example.net

# Where config, state and output live. Default: ~/.local/share/bottle-school
# BOTTLE_HOME=

# VM backend: qemu (default) or krun (experimental; see README "VM backends").
# PI_V2_VMM=qemu
# KRUN_VMLINUX=
# PI_GUEST_BROWSER=1
