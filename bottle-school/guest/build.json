{
  "arch": "x86_64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "pi-guest-shared",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "init": {
    "rootfsInit": "rootfs-init.sh"
  },
  "env": {
    "PATH": "/opt/uv/venv/bin:/usr/local/bin:/opt/mise/shims:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin",
    "MISE_DATA_DIR": "/opt/mise",
    "PI_OFFLINE": "1",
    "PI_TELEMETRY": "0",
    "PI_SKIP_VERSION_CHECK": "1",
    "UV_CACHE_DIR": "/opt/uv/cache",
    "UV_PYTHON_INSTALL_DIR": "/opt/uv/python",
    "UV_PYTHON_PREFERENCE": "only-managed",
    "UV_PYTHON_DOWNLOADS": "never",
    "VIRTUAL_ENV": "/opt/uv/venv",
    "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers"
  }
}
