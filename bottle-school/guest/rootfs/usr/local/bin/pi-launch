#!/bin/sh
# Starts Pi from the trusted configuration the host mounted read-only at /etc/bottle-school.
set -eu
mkdir -p "$HOME/.pi/agent" /work/.pi-session
cp /etc/bottle-school/models.json /etc/bottle-school/settings.json /etc/bottle-school/APPEND_SYSTEM.md /etc/bottle-school/mcp.json /etc/bottle-school/web-search.json "$HOME/.pi/agent/"
cd /work
set --
while IFS= read -r argument; do set -- "$@" "$argument"; done < /etc/bottle-school/args
# Always-on extensions baked into the image (pinned in guest/pi-package.json); opt-in ones arrive as -e args
for extension in /opt/pi-extensions/*; do set -- "$@" -e "$extension"; done
exec pi "$@"
